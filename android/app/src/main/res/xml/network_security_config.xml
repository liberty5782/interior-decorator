<?xml version="1.0" encoding="utf-8"?>
<!-- The backend runs on the home LAN/VPN over plain HTTP, at an address the user types in.
     Cleartext is allowed for that reason; put the server behind HTTPS to tighten this. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
